# Telegram API Credentials
# Obtain these by logging into https://my.telegram.org and going to "API development tools"
API_ID=your_api_id_here
API_HASH=your_api_hash_here

# Download base: web uses <chosen folder>/<channel_in_snake_case>; CLI defaults to <DOWNLOAD_DIR>/<type>
DOWNLOAD_DIR=downloads

# Concurrency and download settings
# BATCH_SIZE: Number of files to download concurrently (recommended: 3 to 10)
BATCH_SIZE=5

# MESSAGE_LIMIT: Max messages to inspect from channel/chat (0 or empty for unlimited)
MESSAGE_LIMIT=2000

# SQLite database: encrypted Telegram session, web jobs, queue state and media history.
# Docker Compose sets this to /app/data/tbmd.db inside its persistent volume.
DB_PATH=tbmd.db

# Required: encryption key for the Telegram session stored in SQLite (AES-256-GCM).
# Generate a strong, unique value, e.g. with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Keep this key safe; losing it makes the stored session impossible to decrypt.
TBMD_SESSION_KEY=

# Access token protecting the web panel (TBMD_WEB_TOKEN).
# When set, every API call requires it. Leave empty for a local-only panel.
TBMD_WEB_TOKEN=

# Web UI Settings (Homelab Dashboard)
WEB_HOST=127.0.0.1
WEB_PORT=8000
