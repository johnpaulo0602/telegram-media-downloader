# Telegram API Credentials
# Obtain these by logging into https://my.telegram.org and going to "API development tools"
API_ID=your_api_id_here
API_HASH=your_api_hash_here

# Telethon session name (stored as <SESSION_NAME>.session)
SESSION_NAME=default_session

# Base folder for downloads (files go to <DOWNLOAD_DIR>/<type> unless another folder is chosen)
DOWNLOAD_DIR=downloads

# Concurrency and download settings
# BATCH_SIZE: Number of files to download concurrently (recommended: 3 to 10)
BATCH_SIZE=5

# MESSAGE_LIMIT: Max messages to inspect from channel/chat (0 or empty for unlimited)
MESSAGE_LIMIT=2000

# Web UI Settings (Homelab Dashboard)
WEB_HOST=0.0.0.0
WEB_PORT=8000
